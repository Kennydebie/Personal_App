# Maak een OAuth 2.0 Web application-client aan in Google Cloud.
# Zet de onderstaande redirect-URI ook in de Google Cloud-console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Alleen dit Google-account mag de app openen.
ALLOWED_EMAIL=

# Een willekeurige sleutel van 32 bytes, gecodeerd als base64url of hex.
# Wordt gebruikt om OAuth-tokens te versleutelen; versleutelt niet het hele SQLite-bestand.
APP_ENCRYPTION_KEY=

# Optioneel: pad naar de lokale SQLite-database met items en broninformatie.
# DATABASE_PATH=./data/regelradar.sqlite

# Standaard wordt herkende werk- en cliëntinhoud niet als item verwerkt.
# Alleen inschakelen als je hiervoor de benodigde toestemming hebt.
# INCLUDE_WORK_CONTENT=true
